{
  "name": "@snyzer/backend",
  "version": "0.1.0",
  "description": "Snyzer backend API (Express service; see src/app.ts and src/server.ts).",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint src tests --max-warnings=0",
    "test": "vitest run",
    "start": "node dist/server.js",
    "db:migrate": "tsc -p tsconfig.json && node dist/scripts/migrate.js"
  },
  "dependencies": {
    "@snyzer/shared": "*",
    "@supabase/supabase-js": "^2.116.0",
    "express": "^4.22.2",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "pino": "^9.14.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "vitest": "^3.2.7"
  }
}
