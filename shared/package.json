{
  "name": "@snyzer/shared",
  "version": "0.1.0",
  "description": "Snyzer shared TypeScript types and validation helpers (SNZ-001 foundation).",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint src tests --max-warnings=0",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "vitest": "^3.2.7"
  }
}
