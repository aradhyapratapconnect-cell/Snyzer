# Snyzer environment example — no real secrets.
# Copy to .env (backend) or .env.local (frontend) as needed and fill in values locally.
# Never commit real keys. Never prefix backend secrets with VITE_.

# --- Backend ---
PORT=5000
NODE_ENV=development
LOG_LEVEL=debug
# Log level: debug | info | warn | error. Defaults to debug outside
# production and info in production when unset.
DATABASE_URL=postgresql://user:password@localhost:5432/snyzer
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Snyzer
MAX_TEXT_LENGTH=10000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30
DAILY_JOB_LIMIT=50

# --- Frontend ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
